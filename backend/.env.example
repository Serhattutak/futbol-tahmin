NODE_ENV=development
PORT=3001

# --------------------------------------------------------------------------
# VERİ SAĞLAYICILARI — SADECE ÜCRETSİZ KAYNAKLAR
# --------------------------------------------------------------------------
# Ücretli "api-football" sağlayıcısı tamamen devre dışı bırakıldı ve
# uygulamada artık kullanılmıyor. Aşağıdaki anahtarları doldurmanıza gerek
# yoktur; api-football için hiçbir istek yapılmaz.
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_BUDGET=100

# Sportmonks (opsiyonel, ücretli) — token tanımlanmazsa otomatik devre dışı kalır.
SPORTMONKS_API_TOKEN=

# football-data.org — ÜCRETSİZ tier. Premier League, La Liga, Bundesliga,
# Serie A ve Ligue 1 gibi ligleri kapsar. Ücretsiz anahtar almak için:
#   https://www.football-data.org/client/register
# Token boş bırakılırsa football-data sağlayıcısı otomatik devre dışı kalır.
FOOTBALL_DATA_API_TOKEN=

# TheSportsDB — ÜCRETSİZ tier. Ücretsiz genel anahtar "123" ile çalışır,
# ayrıca kayıt gerektirmez.
THESPORTSDB_API_KEY=123

# OpenFootball — tamamen ÜCRETSİZ (GitHub üzerinden JSON), anahtar gerektirmez.

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
